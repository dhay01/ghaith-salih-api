[Unit]
Description=ghaith-salih-api queue worker (vips dzsave)
After=network.target

[Service]
User=www-data
Group=www-data
Restart=always
RestartSec=3
WorkingDirectory=/var/www/ghaith-salih-api
ExecStart=/usr/bin/php /var/www/ghaith-salih-api/artisan queue:work database --sleep=1 --tries=1 --timeout=1800 --max-time=3600
Nice=10

[Install]
WantedBy=multi-user.target
