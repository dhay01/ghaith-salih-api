# ---------------------------------------------------------------------------
# Copy to .env and fill in. Everything marked PRODUCTION must be changed before
# this is reachable from the internet.
# ---------------------------------------------------------------------------

APP_NAME="ghaith salih"

# PRODUCTION: set to "production".
APP_ENV=local

# Generate with: php artisan key:generate
APP_KEY=

# PRODUCTION: MUST be false. When true, any error prints a full stack trace,
# file paths and environment values to whoever triggered it.
APP_DEBUG=true

# PRODUCTION: the API's own public address, e.g. https://api.example.com
# Every image URL is built from this — a wrong value serves JSON whose photos 404.
APP_URL=http://127.0.0.1:8123

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite is fine for a low-traffic site and makes backups a file copy. The file
# lives at database/database.sqlite and must be writable by the web server.
# For MySQL, set mysql here and fill in the DB_* block below.
DB_CONNECTION=sqlite
# Production uses MySQL — swap DB_CONNECTION to mysql and fill these in.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ghaith_salih
# DB_USERNAME=
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Uploaded photos must live on a web-served disk, not the private default.
MEDIA_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# PRODUCTION: "log" writes mail to storage/logs instead of sending it, so nobody
# receives anything. Set to smtp and fill in the credentials below.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_ADMIN_ADDRESS="creator@ghaithsalih.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Comma-separated browser origins allowed to call the API.
# PRODUCTION: the site's real address, comma separated. The browser blocks every
# API call from an origin that is not listed here, and the site renders empty.
FRONTEND_ORIGINS="http://localhost:5173,http://localhost:5174"

# ---------------------------------------------------------------------------
# Images and deep zoom
# ---------------------------------------------------------------------------

# Uploads must go to a web-served disk. Never "local": that writes to
# storage/app/private, which the web server refuses to serve.
MEDIA_DISK=public

# Path to the vips binary if it is not on PATH.
# Install with: apt install libvips-tools   (or: brew install vips)
# VIPS_BINARY=/usr/bin/vips

# Tile geometry. 512 produces about a quarter as many files as the 256 default.
# GIGAPIXEL_TILE_SIZE=512
# GIGAPIXEL_QUALITY=85

# Where tile pyramids are written. Point at an S3-compatible disk if the host
# wipes its filesystem on deploy.
# GIGAPIXEL_DISK=public

# Longest a single tiling job may run, in seconds.
# GIGAPIXEL_TIMEOUT=1800
